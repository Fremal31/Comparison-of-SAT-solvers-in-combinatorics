{
  "metrics_measured": {
    "problem": true,
    "formulator": true,
    "breaker": true,
    "solver": true,
    "parent_problem": true,
    "parameters": true,
    
    "status": true,

    "cpu_usage_avg": true,
    "memory_peak_mb": true,
    "time": true,
    "cpu_time": true,
    "total_time": true,
    "exit_code": true,

    "conversion": {
      "conversion_time": true,
      "conversion_cpu_time": true,
      "conversion_memory_mb": true
    },

    "breaking": {
      "break_time": true,
      "break_cpu_time": true,
      "break_memory_mb": true
    },

    "cores_used": true,

    "sat": {
      "restarts": true,
      "conflicts": true,
      "branches": true,
      "decisions": true,
      "propagations": true
    },

    "ilp": {
      "nodes": true,
      "iterations": true,
      "objective": true
    },

    "error": true,
    "stderr": true,
    "stdout": false
  },
  "triplets": [
    {
      "problem": "petersen",
      "formulator": "hamilton_SAT_v2"
    },
    {
      "problem": "cubic_hamiltonian",
      "formulator": "hamilton_ILP"
    }
  ],
  "formulators": {
    "hamilton_SAT":    {"type": "SAT",   "cmd": "../formulator/hamilton_SAT.py",     "enabled": true,  "options": ["-", "<", "{input}"], "output_mode": "stdout"},
    "hamilton_SAT_v2": {"type": "SAT",   "cmd": "../formulator/hamilton_SAT_v2.py",  "enabled": true,  "options": ["-", "<", "{input}"], "output_mode": "stdout"},
    "hamilton_log":    {"type": "SAT",   "cmd": "../formulator/hamilton_log_SAT.py", "enabled": true,  "options": ["-", "<", "{input}"], "output_mode": "stdout"},
    "hamilton_ILP":    {"type": "ILP",   "cmd": "../formulator/hamilton_ILP.py",     "enabled": true,  "options": ["-", "<", "{input}"], "output_mode": "stdout"},
    "hamilton_CPSAT":  {"type": "CPSAT", "cmd": "../formulator/g6_splitter.py",      "enabled": true,  "options": ["{input}", "{output}"], "output_mode": "directory"},
    "hamilton_SMT":    {"type": "SMT",   "cmd": "../formulator/dummy_formulator.py", "enabled": false, "options": ["{input}", "{output}"], "output_mode": "stdout"}
  },
  "breakers": {
    "breakid": {"type": "SAT", "cmd": "breakid", "enabled": false, "options": [], "threads": 1}
  },
  "solvers": {
    "Glucose": {"type": "SAT", "cmd": "glucose", "enabled": false, "parser": "Glucose"},
    "cadical_cmd": {"type": "SAT", "cmd": "cadical", "enabled": true, "options": ["-f"], "threads": 1},
    "kissat_cmd": {"type": "SAT", "cmd": "kissat", "enabled": true, "options": ["-n", "{input}"], "parser": "Kissat", "threads": 1},
    "isasat": {"type": "SAT", "cmd": "isasat", "enabled": false, "options": [], "parser": "Kissat"},
    "yalsat": {"type": "SAT", "cmd": "yalsat", "enabled": false, "options": [], "parser": "Kissat"},

    "highs_cmd": {"type": "ILP", "cmd": "highs", "enabled": true, "options": [], "parser": "Highs"},
    "scip_cmd": {"type": "ILP", "cmd": "scip", "enabled": false, "options": ["-f", "{input}"]},

    "z3_cmd":    {"type": "SMT",   "cmd": "../solver_exec/hamilton_Z3_from_raw.py", "enabled": false, "options": []},
    "cpsat_cmd": {"type": "CPSAT", "cmd": "../solver_exec/hamilton_cpsat.py", "enabled": true,  "options": [], "parser": "CPSAT"}
  },
  "files": {
    "petersen":             {"path": "../examples/showcase/petersen.g6"},
    "cubic_hamiltonian":    {"path": "../examples/showcase/cubic_hamiltonian.g6"},
    "cubic_nonhamiltonian": {"path": "../examples/showcase/cubic_nonhamiltonian.g6"},
    "unique_hamiltonian":   {"path": "../examples/showcase/unique_hamiltonian.g6"}
  },
  "without_converter": {
    "hamilton_without_converter": {"path": "../examples/hamilton/hamilton_biggood2.txt", "type": "SAT", "enabled": false},
    "vertex_without_converter": {"path": "../examples/vertexColoring/good3_951.txt", "type": "SAT", "enabled": true},
    "test_lp_without_converter": {"path": "../examples/test.lp", "type": "ILP", "enabled": true}
  },
  "triplet_mode": false,
  
  "threading": {
    "max_threads": 0,
    "allowed_cores": null,
    "ensure_cleanup_on_crash": false,
    "monitor_poll_interval": 0.5
  },

  "timeout": 10,

  "working_dir": "/tmp/solver_comparison",
  "delete_working_dir": true,
  "use_hardlink": true,
  
  "results_csv": "../results/multi_solver_results.csv",
  "results_json": "../results/multi_solver_results.json",
  "results_jsonl": "../results/multi_solver_results.jsonl",
  "results_html": "../results/multi_solver_results.html",

  "visualization": {
    "enabled": true,
    "output_dir": "../results/plots",
    "per_problem": true,
    "comparison": true
  }

}
